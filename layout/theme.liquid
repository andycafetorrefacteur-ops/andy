          <p class="andy-quiz-option-text">Fruité & Vif</p>
        </div>
        <div class="andy-quiz-option" onclick="quizAnswer(1, 'tres-fruite')">
          <span class="andy-quiz-option-emoji">🍇</span>
          <p class="andy-quiz-option-text">Très Fruité Vif</p>
        </div>
        <div class="andy-quiz-option" onclick="quizAnswer(1, 'floral')">
          <span class="andy-quiz-option-emoji">🌸</span>
          <p class="andy-quiz-option-text">Floral & Délicat</p>
        </div>
        <div class="andy-quiz-option" onclick="quizAnswer(1, 'equilibre')">
          <span class="andy-quiz-option-emoji">⚖️</span>
          <p class="andy-quiz-option-text">Équilibré</p>
        </div>
      </div>
    </div>

    <!-- Étape 2 -->
    <div class="andy-quiz-step" id="step2">
      <div class="andy-quiz-emoji">💪</div>
      <h2 class="andy-quiz-question">Quelle intensité préférez-vous?</h2>
      <div class="andy-quiz-options">
        <div class="andy-quiz-option" onclick="quizAnswer(2, 'intense')">

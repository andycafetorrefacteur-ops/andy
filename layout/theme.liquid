<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {{ 'andy-animations.css' | asset_url | stylesheet_tag }}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}

  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script>
      // Inline header height calculation to prevent layout shift
      // Note: Updates in calculateHeaderGroupHeight() and updateTransparentHeaderOffset()utilities.js should be kept in sync with this function
      (function setHeaderHeighCustomProperties() {
        /*
         * Header calculation functions for maintaining CSS variables
         * Mimic calculateHeaderGroupHeight() in utilities.js
         */
        const header = document.querySelector('header-component');
        const headerGroup = document.querySelector('#header-group');
        const hasHeaderSection = headerGroup?.querySelector('.header-section');

        if (!header || !headerGroup) return;

        const headerHeight = header.offsetHeight;

        // Calculate the total height of the header group
        let headerGroupHeight = 0;
        const children = headerGroup.children;
        for (let i = 0; i < children.length; i++) {
          const element = children[i];
          if (element === header || !(element instanceof HTMLElement)) continue;
          headerGroupHeight += element.offsetHeight;
        }

        // Check for transparent header special case
        if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
          headerGroupHeight += headerHeight;
        }

        // Set CSS variables
        document.body.style.setProperty('--header-height', `${headerHeight}px`);
        document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);

        /**
         * Updates CSS custom properties for transparent header offset calculation
         * Mimic updateTransparentHeaderOffset() in utilities.js
         */

        if (!hasHeaderSection || !header?.hasAttribute('transparent')) {
          document.body.style.setProperty('--transparent-header-offset-boolean', '0');
          return;
        }

        const hasImmediateSection = hasHeaderSection.nextElementSibling?.classList.contains('shopify-section');

        const shouldApplyOffset = !hasImmediateSection ? '1' : '0';
        document.body.style.setProperty('--transparent-header-offset-boolean', shouldApplyOffset);
      })();
    </script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
<!-- Andy Café Quiz - Version Fonctionnelle Complète ☕ -->
<style>
  .andy-quiz-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(20, 15, 10, 0);
    z-index: 9999;
    transition: background 0.6s ease;
  }

  .andy-quiz-overlay.active {
    display: flex;
    justify-content: center;
    align-items: center;
    background: rgba(20, 15, 10, 0.9);
  }

  .andy-quiz-box {
    background: linear-gradient(135deg, #F5EBE0 0%, #E8D5C4 100%);
    border-radius: 30px;
    max-width: 600px;
    width: 90%;
    max-height: 90vh;
    overflow-y: auto;
    padding: 50px 40px;
    position: relative;
    box-shadow: 0 30px 80px rgba(139, 69, 19, 0.6);
    transform: scale(0.5);
    opacity: 0;
    transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .andy-quiz-overlay.active .andy-quiz-box {
    transform: scale(1);
    opacity: 1;
  }

  .andy-quiz-close {
    position: absolute;
    top: 20px;
    right: 20px;
    background: #8B4513;
    color: white;
    border: none;
    width: 45px;
    height: 45px;
    border-radius: 50%;
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(139, 69, 19, 0.4);
    z-index: 10;
  }

  .andy-quiz-close:hover {
    background: #A0522D;
    transform: rotate(90deg) scale(1.1);
  }

  .andy-quiz-progress {
    height: 6px;
    background: rgba(139, 69, 19, 0.2);
    border-radius: 10px;
    margin-bottom: 30px;
    overflow: hidden;
  }

  .andy-quiz-progress-bar {
    height: 100%;
    background: linear-gradient(90deg, #8B4513, #D4A574);
    border-radius: 10px;
    width: 0%;
    transition: width 0.6s ease;
  }

  .andy-quiz-step {
    display: none;
    text-align: center;
    animation: fadeIn 0.5s ease;
  }

  .andy-quiz-step.active {
    display: block;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .andy-quiz-emoji {
    font-size: 70px;
    margin-bottom: 20px;
    display: inline-block;
    animation: bounce 1s ease;
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-20px); }
  }

  .andy-quiz-question {
    font-family: Georgia, serif;
    font-size: 28px;
    color: #8B4513;
    margin: 0 0 30px;
    font-weight: 700;
  }

  .andy-quiz-options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 15px;
    margin-top: 25px;
  }

  .andy-quiz-option {
    background: white;
    border: 3px solid transparent;
    border-radius: 20px;
    padding: 25px 20px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 0 5px 20px rgba(139, 69, 19, 0.1);
  }

  .andy-quiz-option:hover {
    transform: translateY(-8px) scale(1.05);
    border-color: #D4A574;
    box-shadow: 0 15px 35px rgba(139, 69, 19, 0.25);
  }

  .andy-quiz-option:active {
    transform: translateY(-4px) scale(1.02);
  }

  .andy-quiz-option-emoji {
    font-size: 40px;
    display: block;
    margin-bottom: 10px;
  }

  .andy-quiz-option-text {
    font-size: 15px;
    font-weight: 700;
    color: #6B5540;
    margin: 0;
  }

  .andy-quiz-option:hover .andy-quiz-option-text {
    color: #8B4513;
  }

  .andy-quiz-result {
    text-align: center;
  }

  .andy-quiz-result-image-wrapper {
    position: relative;
    width: 100%;
    max-width: 350px;
    margin: 25px auto;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 15px 40px rgba(139, 69, 19, 0.3);
    animation: popIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes popIn {
    0% { transform: scale(0); }
    100% { transform: scale(1); }
  }

  .andy-quiz-result-image {
    width: 100%;
    height: 250px;
    object-fit: cover;
    object-position: center 65%;
    display: block;
  }

  .andy-quiz-result-emoji-overlay {
    position: absolute;
    top: 15px;
    right: 15px;
    font-size: 60px;
    background: rgba(255, 255, 255, 0.95);
    width: 80px;
    height: 80px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
    animation: float 3s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-10px) rotate(5deg); }
  }

  .andy-quiz-result-title {
    font-family: Georgia, serif;
    font-size: 32px;
    color: #8B4513;
    margin: 20px 0 15px;
    font-weight: 700;
    animation: slideUp 0.6s ease 0.2s both;
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .andy-quiz-result-desc {
    font-size: 16px;
    color: #6B5540;
    margin: 15px 0 25px;
    line-height: 1.6;
    animation: slideUp 0.6s ease 0.4s both;
  }

  .andy-quiz-result-tags {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin: 20px 0;
    animation: slideUp 0.6s ease 0.3s both;
  }

  .andy-quiz-result-tag {
    background: linear-gradient(135deg, #D4A574, #C19A6B);
    color: white;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 700;
  }

  .andy-quiz-btn {
    background: linear-gradient(135deg, #8B4513, #A0522D);
    color: white;
    border: none;
    padding: 16px 40px;
    border-radius: 30px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    margin: 10px 5px;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 0 6px 20px rgba(139, 69, 19, 0.3);
    text-decoration: none;
    display: inline-block;
    animation: slideUp 0.6s ease 0.5s both;
  }

  .andy-quiz-btn:hover {
    transform: translateY(-5px) scale(1.05);
    box-shadow: 0 12px 35px rgba(139, 69, 19, 0.5);
  }

  .andy-quiz-btn:active {
    transform: translateY(-2px) scale(1.02);
  }

  .andy-quiz-btn-secondary {
    background: transparent;
    border: 2px solid #8B4513;
    color: #8B4513;
    box-shadow: none;
  }

  .andy-quiz-btn-secondary:hover {
    background: rgba(139, 69, 19, 0.1);
    transform: translateY(-3px);
  }

  @media (max-width: 768px) {
    .andy-quiz-box {
      padding: 40px 25px;
      max-height: 95vh;
    }
    .andy-quiz-question {
      font-size: 24px;
    }
    .andy-quiz-options {
      grid-template-columns: 1fr;
    }
    .andy-quiz-result-image-wrapper {
      max-width: 100%;
    }
    .andy-quiz-result-image {
      height: 200px;
    }
    .andy-quiz-result-emoji-overlay {
      font-size: 50px;
      width: 70px;
      height: 70px;
    }
  }
</style>

<div class="andy-quiz-overlay" id="andyQuiz">
  <div class="andy-quiz-box">
    <button class="andy-quiz-close" onclick="quizClose()">×</button>
    
    <div class="andy-quiz-progress">
      <div class="andy-quiz-progress-bar" id="quizProgressBar"></div>
    </div>

    <!-- Étape 1 -->
    <div class="andy-quiz-step active" id="step1">
      <div class="andy-quiz-emoji">☕</div>
      <h2 class="andy-quiz-question">Quel profil de saveur vous attire?</h2>
      <div class="andy-quiz-options">
        <div class="andy-quiz-option" onclick="quizAnswer(1, 'chocolat')">
          <span class="andy-quiz-option-emoji">🍫</span>
          <p class="andy-quiz-option-text">Chocolaté & Gourmand</p>
        </div>
        <div class="andy-quiz-option" onclick="quizAnswer(1, 'fruite')">

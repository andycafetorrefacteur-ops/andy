        </div>
        <div class="andy-quiz-option" onclick="quizAnswer(2, 'doux')">
          <span class="andy-quiz-option-emoji">🌤️</span>
          <p class="andy-quiz-option-text">Doux & Subtil</p>
        </div>
      </div>
    </div>

    <!-- Étape 3 -->
    <div class="andy-quiz-step" id="step3">
      <div class="andy-quiz-emoji">🥤</div>
      <h2 class="andy-quiz-question">Comment buvez-vous votre café?</h2>
      <div class="andy-quiz-options">
        <div class="andy-quiz-option" onclick="quizAnswer(3, 'espresso')">
          <span class="andy-quiz-option-emoji">☕</span>
          <p class="andy-quiz-option-text">Espresso</p>
        </div>
        <div class="andy-quiz-option" onclick="quizAnswer(3, 'allonge')">
          <span class="andy-quiz-option-emoji">🫖</span>
          <p class="andy-quiz-option-text">Allongé/Filtre</p>
        </div>
        <div class="andy-quiz-option" onclick="quizAnswer(3, 'lait')">
          <span class="andy-quiz-option-emoji">🥛</span>
          <p class="andy-quiz-option-text">Avec Lait</p>
        </div>
        <div class="andy-quiz-option" onclick="quizAnswer(3, 'glace')">
          <span class="andy-quiz-option-emoji">🧊</span>
          <p class="andy-quiz-option-text">Glacé</p>
        </div>
      </div>
    </div>

    <!-- Résultat -->
    <div class="andy-quiz-step andy-quiz-result" id="stepResult">
      <h2 class="andy-quiz-question">🎉 Votre café parfait!</h2>
      
      <div class="andy-quiz-result-image-wrapper">
        <img id="resultImage" class="andy-quiz-result-image" src="" alt="Café">
        <div class="andy-quiz-result-emoji-overlay" id="resultEmojiOverlay">☕</div>
      </div>
      
      <h3 class="andy-quiz-result-title" id="resultName">Café</h3>
      <div class="andy-quiz-result-tags" id="resultTags"></div>
      <p class="andy-quiz-result-desc" id="resultDesc">Description</p>
      <a href="#" class="andy-quiz-btn" id="resultLink" target="_blank">Découvrir ce café</a>
      <button class="andy-quiz-btn andy-quiz-btn-secondary" onclick="quizRestart()">Recommencer</button>
    </div>
  </div>
</div>

<script>
(function() {
  var quizData = {};
  var quizStep = 1;

  var coffees = {
    'bresil': {
      name: 'Brésil',
      emoji: '☕',
      tags: ['Chocolat', 'Noisette', 'Fruits secs'],
      desc: 'Un café riche et gourmand avec des notes de chocolat et de noisette. Parfait pour ceux qui aiment les saveurs douces et équilibrées.',
      url: 'https://andycafetorrefacteur.com/products/cafe-origine-bresil',
      image: 'https://andycafetorrefacteur.com/cdn/shop/files/BRESIL_770afdde-7d4a-4f7c-b221-48dc6244749b.png?v=1767898122&width=500'
    },
    'colombie': {
      name: 'Colombie',
      emoji: '🌺',
      tags: ['Vanille', 'Caramel', 'Cacao'],
      desc: 'Doux et équilibré avec des touches de vanille et de caramel. Un classique indémodable qui plaît à tous.',
      url: 'https://andycafetorrefacteur.com/products/cafe-origine-colombie',
      image: 'https://andycafetorrefacteur.com/cdn/shop/files/colombie_0bb3a7ba-7cf7-4a52-897c-08b6fbfde347.png?v=1767897908&width=500'
    },
    'ethiopie-guji': {
      name: 'Éthiopie Guji',
      emoji: '🌸',
      tags: ['Baies', 'Floral', 'Fruits'],
      desc: 'Un café exotique et complexe avec des notes fruitées intenses de baies sauvages et des touches florales délicates.',
      url: 'https://andycafetorrefacteur.com/products/cafe-origine-ethiopie',
      image: 'https://andycafetorrefacteur.com/cdn/shop/files/ETHIOPIEGUJI.png?v=1767897863&width=500'
    },
    'kenya-aa': {
      name: 'Kenya AA',
      emoji: '🌹',
      tags: ['Agrumes', 'Eau de rose', 'Floral'],
      desc: 'Un café délicat et raffiné avec une belle acidité d\'agrumes et des notes subtiles d\'eau de rose. Parfait pour les amateurs de cafés floraux.',
      url: 'https://andycafetorrefacteur.com/products/kenya-aa',
      image: 'https://andycafetorrefacteur.com/cdn/shop/files/KENYA_AA.png?v=1769969941&width=500'
    },
    'red-plum': {
      name: 'Colombie El Paraiso Red Plum',
      emoji: '✨',
      tags: ['Prune rouge', 'Fruité intense', 'Édition limitée'],
      desc: 'Notre édition limitée! Un café d\'exception aux notes explosives de prune rouge. Thé, jus de fruits, très juteux et acide.',
      url: 'https://andycafetorrefacteur.com/products/colombie-el-paraiso-red-plum-cafe-edition-limitee',
      image: 'https://andycafetorrefacteur.com/cdn/shop/files/ELPARAISOREDPLUM_2c77d7c2-c6c9-4c38-a3f9-72694764bb9e.png?v=1767905631&width=500'
    },
    'lychee-peach': {
      name: 'Colombie El Paraiso Lychee Peach',
      emoji: '💫',
      tags: ['Litchi', 'Pêche', 'Édition limitée'],
      desc: 'Notre édition limitée qui fait capoter! Des notes vibrantes de litchi et pêche, parfait en café filtre. Thé, jus, très juteux!',
      url: 'https://andycafetorrefacteur.com/products/colombie-el-paraiso-lychee-peach-cafe-edition-limitee',
      image: 'https://andycafetorrefacteur.com/cdn/shop/files/LYCHEEPEACH.png?v=1767906226&width=500'
    },
    'melange-andy': {
      name: 'Mélange Andy',
      emoji: '☀️',
      tags: ['Équilibré', 'Riche', 'Passe-partout'],
      desc: 'Notre signature et valeur sûre! Un mélange parfaitement équilibré qui fonctionne à tout moment. Le passe-partout idéal!',
      url: 'https://andycafetorrefacteur.com/products/melange-andy',
      image: 'https://andycafetorrefacteur.com/cdn/shop/files/melange_andy_site_web.png?v=1767898071&width=500'
    },
    'melange-espresso': {
      name: 'Mélange Espresso',
      emoji: '🔥',
      tags: ['Chocolat noir', 'Orange', 'Crémeux'],
      desc: 'Intense et corsé, spécialement conçu pour l\'espresso. Notes de chocolat noir avec une touche d\'orange et une crema onctueuse.',
      url: 'https://andycafetorrefacteur.com/products/melange-espresso-andy-cafe',
      image: 'https://andycafetorrefacteur.com/cdn/shop/files/MELANGEESPRESSO.png?v=1767897807&width=500'
    },
    'colombie-decaf': {
      name: 'Colombie Décaféiné',
      emoji: '🌙',
      tags: ['Sans caféine', 'Doux', 'Caramel'],
      desc: 'Tout le plaisir du café sans la caféine! Doux et équilibré avec des notes de caramel. Parfait pour le soir ou pour ceux qui évitent la caféine.',
      url: 'https://andycafetorrefacteur.com/products/colombie-decaf',
      image: 'https://andycafetorrefacteur.com/cdn/shop/files/COLOMBIE_DECAF.png?v=1769969941&width=500'
    }
  };

  window.quizAnswer = function(step, answer) {
    quizData[step] = answer;
    
    var current = document.getElementById('step' + step);
    current.classList.remove('active');
    
    if (step < 3) {
      quizStep++;
      setTimeout(function() {
        document.getElementById('step' + quizStep).classList.add('active');
        var progress = (quizStep / 3) * 100;
        document.getElementById('quizProgressBar').style.width = progress + '%';
      }, 300);
    } else {
      setTimeout(function() {
        quizShowResult();
      }, 300);
    }
  };

  function quizShowResult() {
    var coffeeKey = quizGetRecommendation();
    var coffee = coffees[coffeeKey];
    
    document.getElementById('resultImage').src = coffee.image;
    document.getElementById('resultImage').alt = coffee.name;
    document.getElementById('resultEmojiOverlay').textContent = coffee.emoji;
    document.getElementById('resultName').textContent = coffee.name;
    document.getElementById('resultDesc').textContent = coffee.desc;
    document.getElementById('resultLink').href = coffee.url;
    
    var tagsHtml = '';
    for (var i = 0; i < coffee.tags.length; i++) {
      tagsHtml += '<span class="andy-quiz-result-tag">' + coffee.tags[i] + '</span>';
    }
    document.getElementById('resultTags').innerHTML = tagsHtml;
    
    document.getElementById('stepResult').classList.add('active');
    document.getElementById('quizProgressBar').style.width = '100%';
  }

  function quizGetRecommendation() {
    var profile = quizData[1];
    var intensity = quizData[2];
    var method = quizData[3];
    
    // CHOCOLATÉ & GOURMAND
    if (profile === 'chocolat') {
      if (intensity === 'doux') return 'bresil';
      if (intensity === 'moyen') return 'melange-andy';
      if (intensity === 'intense') return 'melange-espresso';
      return 'melange-andy'; // Valeur sûre par défaut
    }
    
    // TRÈS FRUITÉ VIF (Thé, jus, acide, juteux)
    if (profile === 'tres-fruite') {
      // Si méthode filtre/allongé, favoriser Lychee Peach (fait capoter!)
      if (method === 'allonge') return 'lychee-peach';
      // Sinon choisir aléatoirement entre les deux éditions limitées
      var limitedEditions = ['red-plum', 'lychee-peach'];
      var randomIndex = Math.floor(Math.random() * limitedEditions.length);
      return limitedEditions[randomIndex];
    }
    
    // FRUITÉ & VIF (Floral + fruits)
    if (profile === 'fruite') {
      // Si filtre/allongé, privilégier éditions limitées ou Kenya
      if (method === 'allonge') {
        var filtreOptions = ['lychee-peach', 'red-plum', 'kenya-aa'];
        return filtreOptions[Math.floor(Math.random() * filtreOptions.length)];
      }
      return 'ethiopie-guji';
    }
    
    // FLORAL & DÉLICAT
    if (profile === 'floral') {
      // Alterner entre Éthiopie Guji et Kenya AA
      var floralOptions = ['ethiopie-guji', 'kenya-aa'];
      return floralOptions[Math.floor(Math.random() * floralOptions.length)];
    }
    
    // ÉQUILIBRÉ
    if (profile === 'equilibre') {
      return 'melange-andy'; // Le passe-partout!
    }
    
    // Par défaut: Mélange Andy (valeur sûre)
    return 'melange-andy';
  }

  window.quizRestart = function() {
    quizData = {};
    quizStep = 1;
    
    document.getElementById('stepResult').classList.remove('active');
    document.getElementById('step1').classList.add('active');
    document.getElementById('quizProgressBar').style.width = '0%';
  };

  window.quizClose = function() {
    var overlay = document.getElementById('andyQuiz');
    overlay.classList.remove('active');
    document.body.style.overflow = '';
    
    var today = new Date().toDateString();
    localStorage.setItem('andyQuizShown', today);
  };

  window.addEventListener('load', function() {
    // Vérifier si on est sur la page d'accueil
    var isHomePage = window.location.pathname === '/' || window.location.pathname === '';
    
    if (!isHomePage) {
      return; // Ne pas afficher le quiz si on n'est pas sur la page d'accueil
    }
    
    var shown = localStorage.getItem('andyQuizShown');
    var today = new Date().toDateString();
    
    if (shown !== today) {
      setTimeout(function() {
        var quiz = document.getElementById('andyQuiz');
        if (quiz) {
          quiz.classList.add('active');
          document.body.style.overflow = 'hidden';
        }
      }, 1000);
    }
  });

  var overlay = document.getElementById('andyQuiz');
  if (overlay) {
    overlay.addEventListener('click', function(e) {
      if (e.target === overlay) {
        quizClose();
      }
    });
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      var quiz = document.getElementById('andyQuiz');
      if (quiz && quiz.classList.contains('active')) {
        quizClose();
      }
    }
  });
})();
</script>
  </body>
</html>

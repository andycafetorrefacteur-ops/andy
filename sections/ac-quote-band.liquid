{% comment %}
  Section: AC Quote Band — editorial pull-quote
{% endcomment %}

<section class="ac-quote-band" {{ section.shopify_attributes }}>
  <blockquote class="lux-reveal-up">
    <p>{{ section.settings.quote }}</p>
    {% if section.settings.author != blank %}
      <cite>{{ section.settings.author }}</cite>
    {% endif %}
  </blockquote>
</section>

{% schema %}
{
  "name": "AC - Citation",
  "tag": "section",
  "class": "ac-quote-section",
  "settings": [
    {
      "type": "textarea",
      "id": "quote",
      "label": "Citation",
      "default": "Le café n'est pas un produit. C'est un terroir, un geste, un instant. Nous lui devons l'exigence."
    },
    {
      "type": "text",
      "id": "author",
      "label": "Auteur / Source",
      "default": "Andy Café — Manifeste"
    }
  ],
  "presets": [
    { "name": "AC - Citation" }
  ]
}
{% endschema %}

<script>
(function(){
  var field = document.getElementById('lfPetaleField');
  if(field){
    var colors = ['#f9dada','#f4c5c5','#e8969a','#fce8ea','#f7d0d8','#fad2da','#c8dbc0'];
    for(var i=0;i<60;i++){
      (function(){
        var el = document.createElementNS('http://www.w3.org/2000/svg','svg');
        var size = 9 + Math.random()*18;
        var col = colors[Math.floor(Math.random()*colors.length)];
        var isLeaf = col === '#c8dbc0';
        el.setAttribute('viewBox','0 0 40 52');
        el.setAttribute('width',size);
        el.setAttribute('height',size*1.35);
        if(isLeaf){
          el.innerHTML = '<ellipse cx="20" cy="26" rx="10" ry="24" fill="'+col+'" opacity=".7" transform="rotate('+ (-20+Math.random()*40) +' 20 26)"/>';
        } else {
          el.innerHTML = '<ellipse cx="20" cy="26" rx="14" ry="23" fill="'+col+'" opacity=".72"/><ellipse cx="20" cy="26" rx="5" ry="20" fill="rgba(255,255,255,.2)" transform="rotate(-12 20 26)"/>';
        }
        el.classList.add('lf-petale');
        el.style.left = Math.random()*100+'vw';
        var dur = 6+Math.random()*9;
        var delay = Math.random()*12;
        el.style.animation = 'lfTombePetale '+dur+'s '+delay+'s linear infinite';
        field.appendChild(el);
      })();
    }
  }

  var obs = new IntersectionObserver(function(entries){
    entries.forEach(function(e,i){ if(e.isIntersecting) setTimeout(function(){ e.target.classList.add('visible'); },i*80); });
  },{threshold:.1});
  document.querySelectorAll('.lf-reveal').forEach(function(r){ obs.observe(r); });

  var numEl = document.getElementById('lfCompteurNum');
  var barEl = document.getElementById('lfCompteurBar');
  var encEl = document.getElementById('lfEncouragement');
  var objectif = 25;

  function animerCompteur(target) {
    var pct = Math.min((target / objectif) * 100, 100);
    setTimeout(function(){ barEl.style.width = pct + '%'; }, 400);
    var messages = [
      { min:0,  max:0,   msg:"Soyez parmi les premiers à contribuer ✿" },
      { min:1,  max:24,  msg:"Le mouvement commence — merci d'y croire ✿" },
      { min:25, max:49,  msg:"Bel élan ! Chaque sac compte énormément ✿" },
      { min:50, max:74,  msg:"Plus de la moitié du chemin — vous êtes incroyables ✿" },
      { min:75, max:99,  msg:"On y est presque ! La communauté se mobilise ✿" },
      { min:100,max:9999,msg:"Objectif atteint ! Merci du fond du cœur ✿" }
    ];
    var pctVal = Math.round(pct);
    messages.forEach(function(m){
      if(pctVal >= m.min && pctVal <= m.max && encEl) encEl.textContent = m.msg;
    });
    if(target === 0){ numEl.textContent = '0'; return; }
    var duration = 1800, startTime = null;
    function step(ts){
      if(!startTime) startTime = ts;
      var progress = Math.min((ts - startTime) / duration, 1);
      var ease = 1 - Math.pow(1 - progress, 3);
      numEl.textContent = Math.round(ease * target);
      if(progress < 1) requestAnimationFrame(step);
      else numEl.textContent = target;
    }
    requestAnimationFrame(step);
  }

  function chargerCompteur() {
    fetch('https://andy-cafe-compteur.vercel.app/api/compteur')
      .then(function(r){ return r.json(); })
      .then(function(data){
        var sacs = data.sacs_vendus || 0;
        numEl.setAttribute('data-target', sacs);
        animerCompteur(sacs);
      })
      .catch(function(){
        var fallback = parseInt(numEl.getAttribute('data-target')) || 0;
        animerCompteur(fallback);
      });
  }

  if(numEl && barEl){
    var started = false;
    var cObs = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting && !started){ started = true; chargerCompteur(); }
      });
    },{threshold:.5});
    cObs.observe(numEl);
    setInterval(chargerCompteur, 300000);
  }

  /* ── Activation automatique samedi 14 mars à 9h ── */
  var lancement = new Date('2026-03-14T09:00:00');
  function verifierLancement() {
    var maintenant = new Date();
    var boutons = document.querySelectorAll('.lf-btn-lancement');
    if (maintenant >= lancement) {
      boutons.forEach(function(btn) {
        btn.style.opacity = '1';
        btn.style.cursor = 'pointer';
        btn.style.pointerEvents = 'auto';
        var sub = btn.querySelector('.lf-btn-sub');
        if (sub) sub.remove();
      });
    } else {
      setTimeout(verifierLancement, 30000);
    }
  }
  verifierLancement();

  /* ── Popup La Bouquet ── */
  window.ouvrirPopupBouquet = function(e) {
    e.preventDefault();
    document.getElementById('lfPopupBouquet').classList.add('active');
    setTimeout(function(){ document.getElementById('lfPopupPrenom').focus(); }, 300);
  };
  window.confirmerBouquet = function() {
    var prenom = document.getElementById('lfPopupPrenom').value.trim();
    if (prenom) {
      fetch('https://andy-cafe-compteur.vercel.app/api/prenoms', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ prenom: prenom })
      });
    }
    document.getElementById('lfPopupBouquet').classList.remove('active');
    window.location.href = '/products/sac-par-les-femmes-pour-les-femmes-fazenda-sao-luiz-400g';
  };
  window.continuerSansPrenom = function() {
    document.getElementById('lfPopupBouquet').classList.remove('active');
    window.location.href = '/products/sac-par-les-femmes-pour-les-femmes-fazenda-sao-luiz-400g';
  };

  /* ── Prénoms remerciements ── */
  function chargerPrenoms() {
    fetch('https://andy-cafe-compteur.vercel.app/api/prenoms')
      .then(function(r){ return r.json(); })
      .then(function(data){
        var grid = document.getElementById('lfPrenoms');
        if (!grid) return;
        grid.innerHTML = '';
        (data.prenoms || []).forEach(function(p) {
          var tag = document.createElement('div');
          tag.className = 'lf-prenom-tag';
          tag.textContent = '✿ ' + p;
          grid.appendChild(tag);
        });
        if (!data.prenoms || data.prenoms.length === 0) {
          grid.innerHTML = '<p style="font-family:\'Playfair Display\',serif;font-style:italic;color:var(--rose-vif);opacity:.6;">Soyez le premier à laisser votre prénom ✿</p>';
        }
      });
  }

  window.soumettrePrenom = function() {
    var input = document.getElementById('lfPrenomInput');
    var msg = document.getElementById('lfRemMsg');
    var prenom = input.value.trim();
    if (!prenom) { msg.textContent = 'Entrez votre prénom ✿'; return; }
    fetch('https://andy-cafe-compteur.vercel.app/api/prenoms', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ prenom: prenom })
    })
    .then(function(r){ return r.json(); })
    .then(function(){
      msg.textContent = 'Merci ' + prenom + ' ! ✿';
      input.value = '';
      chargerPrenoms();
    });
  };

  chargerPrenoms();
  setInterval(chargerPrenoms, 60000);

  document.querySelectorAll('a[href^="#lf-"]').forEach(function(a){
    a.addEventListener('click',function(e){
      var t = document.querySelector(a.getAttribute('href'));
      if(t){ e.preventDefault(); t.scrollIntoView({behavior:'smooth'}); }
    });
  });
})();
</script>


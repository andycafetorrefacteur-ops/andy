  "settings": [
    {
      "type": "number",
      "id": "sacs_vendus",
      "label": "Nombre de sacs vendus",
      "info": "Mets à jour ce chiffre manuellement après chaque vente.",
      "default": 0
    },
    {
      "type": "number",
      "id": "objectif_sacs",
      "label": "Objectif (nombre de sacs)",
      "default": 25
    }
  ]
}

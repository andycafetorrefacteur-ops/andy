{% comment %}
  Section: AC Featured Products — luxury card grid
{% endcomment %}

<section class="ac-section" {{ section.shopify_attributes }}>
  <div class="ac-section-inner">
    <div class="ac-section-header">
      <div>
        {% if section.settings.eyebrow != blank %}
          <span class="lux-eyebrow lux-reveal">{{ section.settings.eyebrow }}</span>
        {% endif %}
        <h2 class="lux-reveal-up">
          {{ section.settings.title_part1 }}
          {% if section.settings.title_accent != blank %}
            <em>{{ section.settings.title_accent }}</em>
          {% endif %}
        </h2>
      </div>
      {% if section.settings.view_all_link != blank %}
        <a href="{{ section.settings.view_all_link }}" class="ac-view-all lux-reveal">
          {{ section.settings.view_all_text | default: 'Voir tout' }}
        </a>
      {% endif %}
    </div>

    <div class="ac-product-grid lux-stagger-parent">
      {%- assign collection_products = section.settings.collection.products -%}
      {%- if collection_products.size > 0 -%}
        {% for product in collection_products limit: section.settings.products_limit %}
          <a href="{{ product.url }}" class="ac-product-card lux-stagger-child">
            <div class="ac-product-card-img">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 800 }}"
                     alt="{{ product.featured_image.alt | default: product.title | escape }}"
                     loading="lazy"
                     width="{{ product.featured_image.width }}"
                     height="{{ product.featured_image.height }}">
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}

              {% if product.metafields.custom.badge %}
                <span class="ac-product-badge">{{ product.metafields.custom.badge }}</span>
              {% elsif product.available == false %}
                <span class="ac-product-badge">Épuisé</span>
              {% elsif product.compare_at_price > product.price %}
                <span class="ac-product-badge">Édition</span>
              {% endif %}
            </div>

            <div class="ac-product-info">
              {% if product.metafields.custom.origin %}
                <div class="ac-product-origin">{{ product.metafields.custom.origin }}</div>
              {% elsif product.vendor != blank %}
                <div class="ac-product-origin">{{ product.vendor }}</div>
              {% endif %}

              <div class="ac-product-name">{{ product.title }}</div>

              {% if product.metafields.custom.short_description %}
                <div class="ac-product-desc">{{ product.metafields.custom.short_description }}</div>
              {% elsif product.description != blank %}
                <div class="ac-product-desc">{{ product.description | strip_html | truncate: 90 }}</div>
              {% endif %}

              <div class="ac-product-footer">
                <span class="ac-product-price">
                  {{ product.price | money_without_trailing_zeros }}
                  <span class="cur">{{ cart.currency.iso_code }}</span>
                </span>
                <button class="ac-add-btn" type="button" aria-label="Voir {{ product.title | escape }}">+</button>
              </div>
            </div>
          </a>
        {% endfor %}
      {%- else -%}
        {% for i in (1..4) %}
          <div class="ac-product-card lux-stagger-child">
            <div class="ac-product-card-img">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="ac-product-info">
              <div class="ac-product-origin">Origine</div>
              <div class="ac-product-name">Café d'exception</div>
              <div class="ac-product-desc">Notes de cacao, agrume, fleurs blanches.</div>
              <div class="ac-product-footer">
                <span class="ac-product-price">22<span class="cur">$</span></span>
                <button class="ac-add-btn" type="button">+</button>
              </div>
            </div>
          </div>
        {% endfor %}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AC - Produits vedettes",
  "tag": "section",
  "class": "ac-featured-products-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Étiquette", "default": "Sélection" },
    { "type": "text", "id": "title_part1", "label": "Titre (partie 1)", "default": "Cafés" },
    { "type": "text", "id": "title_accent", "label": "Mot accent (italique)", "default": "signature" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_limit", "label": "Nombre de produits", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "text", "id": "view_all_text", "label": "Texte 'Voir tout'", "default": "Voir tous les cafés" },
    { "type": "url", "id": "view_all_link", "label": "Lien 'Voir tout'" }
  ],
  "presets": [
    { "name": "AC - Produits vedettes" }
  ]
}
{% endschema %}

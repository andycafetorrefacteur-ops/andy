{% comment %}
  Section: AC Newsletter — luxury subscribe band
{% endcomment %}

<section class="ac-signup-section" {{ section.shopify_attributes }}>
  <div class="ac-signup-inner">
    {% if section.settings.eyebrow != blank %}
      <span class="lux-eyebrow lux-reveal">{{ section.settings.eyebrow }}</span>
    {% endif %}

    <h2 class="lux-reveal-up">
      {{ section.settings.title }}
      {% if section.settings.title_accent != blank %} <em>{{ section.settings.title_accent }}</em>{% endif %}
    </h2>

    {% if section.settings.description != blank %}
      <p class="lux-reveal">{{ section.settings.description }}</p>
    {% endif %}

    {% form 'customer', class: 'ac-signup-form lux-reveal' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="email"
             name="contact[email]"
             placeholder="{{ section.settings.placeholder }}"
             required
             aria-label="{{ section.settings.placeholder }}"
             autocomplete="email">
      <button type="submit" class="lux-magnetic">{{ section.settings.button_text }}</button>
    {% endform %}

    {% if form.posted_successfully? %}
      <p class="lux-reveal" style="color: var(--ac-gold); margin: 8px 0 0;">{{ section.settings.success_message }}</p>
    {% endif %}

    {% if section.settings.fineprint != blank %}
      <p class="ac-signup-fineprint lux-reveal">{{ section.settings.fineprint }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "AC - Newsletter",
  "tag": "section",
  "class": "ac-newsletter-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Étiquette",
      "default": "Lettre confidentielle"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Le café qui se"
    },
    {
      "type": "text",
      "id": "title_accent",
      "label": "Mot accent (italique)",
      "default": "savoure d'abord"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Cuvées exclusives, accès anticipé, rituels de dégustation. Une lettre par mois, jamais plus."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder email",
      "default": "votre@adresse.com"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texte du bouton",
      "default": "S'abonner"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Message de succès",
      "default": "Bienvenue. À bientôt dans votre boîte."
    },
    {
      "type": "text",
      "id": "fineprint",
      "label": "Texte légal",
      "default": "Désinscription en un clic. Pas de spam, jamais."
    }
  ],
  "presets": [
    { "name": "AC - Newsletter" }
  ]
}
{% endschema %}

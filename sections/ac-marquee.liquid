{% comment %}
  Section: AC Marquee — luxury edition (italic display, gold dots, fade edges)
{% endcomment %}

<div class="ac-marquee-wrap" {{ section.shopify_attributes }}>
  <div class="ac-marquee-track">
    {%- for i in (1..2) -%}
      {% for block in section.blocks %}
        <span class="ac-marquee-item{% if forloop.index0 | modulo: 2 == 1 %} is-outlined{% endif %}" {{ block.shopify_attributes }}>
          <span class="ac-marquee-dot" aria-hidden="true"></span>
          {{ block.settings.text }}
        </span>
      {% endfor %}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "AC - Marquee",
  "tag": "section",
  "class": "ac-marquee-section",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Élément",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Café d'exception"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AC - Marquee",
      "blocks": [
        { "type": "item", "settings": { "text": "Torréfié au Québec" } },
        { "type": "item", "settings": { "text": "Origines rares" } },
        { "type": "item", "settings": { "text": "Petits lots artisanaux" } },
        { "type": "item", "settings": { "text": "Livraison gratuite 50$+" } },
        { "type": "item", "settings": { "text": "Fraîcheur signature" } }
      ]
    }
  ]
}
{% endschema %}
